# ─────────────────────────────────────────────────────────────────────────────
# Skill Donor Operations Hub — configurazione d'ambiente
#
# Copiare in `.env` e compilare. NON committare mai il file `.env`.
# L'applicazione si avvia anche con questo file vuoto: parte in modalità demo
# su un database PGlite locale, dichiarando in interfaccia ciò che non è attivo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Lasciare vuoto per usare PGlite (PostgreSQL in-process, nessun servizio da
# avviare): è il percorso consigliato per lo sviluppo e per la demo.
# Per un PostgreSQL reale (Docker Compose incluso nel repository):
#   DATABASE_URL=postgres://sdoh:sdoh_local_dev@localhost:5433/sdoh
DATABASE_URL=

# Directory dei dati PGlite, relativa alla radice del monorepo.
# `memory://` crea un database effimero (usato dai test).
PGLITE_DIR=.data/pglite


# ── Sicurezza ────────────────────────────────────────────────────────────────
# OBBLIGATORIA in produzione. Cifra i token OAuth at rest (AES-256-GCM) e il
# cookie di sessione. Generarla con:
#   openssl rand -base64 32
# Ruotandola si invalidano tutte le sessioni e i token Gmail salvati.
TOKEN_ENCRYPTION_KEY=

# `off` disabilita l'ingresso in modalità demo. Consigliato in produzione,
# quando Google OAuth è configurato.
DEMO_MODE=on

# Abilita /api/admin/migrate, che crea lo schema su un database remoto senza
# bisogno di un terminale con Node e pnpm. Minimo 16 caratteri.
# Serve una volta sola: RIMUOVERLA subito dopo la configurazione, così la rotta
# torna a rispondere 404. Lasciata vuota, l'endpoint non esiste.
MIGRATION_TOKEN=


# ── Accesso Google (OAuth 2.0) ───────────────────────────────────────────────
# Procedura completa in `docs/gmail-oauth.md`.
# L'app NON usa e non accetta password: solo authorization code flow con PKCE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deve coincidere ESATTAMENTE con l'URI registrato in Google Cloud Console.
#   sviluppo:   http://localhost:3200/api/auth/callback
#   produzione: https://ops.skilldonor.org/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3200/api/auth/callback

# Allowlist: l'unico indirizzo autorizzato ad accedere. Verificato sull'id_token
# firmato da Google, non su un valore auto-dichiarato.
ALLOWED_EMAIL=g.salerno@skilldonor.org


# ── Provider AI ──────────────────────────────────────────────────────────────
# Senza chiavi l'app funziona con l'adapter mock deterministico, sempre
# etichettato come tale nell'interfaccia e nel registro AI.
#
# Gli identificativi dei modelli NON sono scritti nel codice, di proposito:
# invecchierebbero insieme all'applicazione. Vanno impostati qui, con il
# modello effettivamente disponibile sul proprio account al momento del deploy.
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=


# ── Test end-to-end ──────────────────────────────────────────────────────────
# Solo per ambienti in cui Chromium è già presente e non si vuole scaricarlo.
# Sulle postazioni normali basta `pnpm exec playwright install chromium`.
PLAYWRIGHT_CHROMIUM_PATH=
