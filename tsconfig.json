{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@sdoh/core": ["./packages/core/src/index.ts"],
      "@sdoh/core/*": ["./packages/core/src/*"],
      "@sdoh/db": ["./packages/db/src/index.ts"],
      "@sdoh/db/*": ["./packages/db/src/*"],
      "@sdoh/ai": ["./packages/ai/src/index.ts"],
      "@sdoh/ai/*": ["./packages/ai/src/*"],
      "@sdoh/email": ["./packages/email/src/index.ts"],
      "@sdoh/email/*": ["./packages/email/src/*"],
      "@sdoh/ui": ["./packages/ui/src/index.ts"],
      "@sdoh/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
